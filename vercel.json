{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build",
  "outputDirectory": "apps/web",
  "regions": ["sin1"],
  "functions": {
    "api/index.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index?path=$1"
    }
  ],
  "crons": [
    {
      "path": "/api/v1/cron/jobs",
      "schedule": "0 8 * * *"
    }
  ]
}
