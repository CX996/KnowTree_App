{
  "name": "knowtree",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "node scripts/sync-web-assets.mjs && pnpm --dir apps/api build",
    "dev": "node scripts/sync-web-assets.mjs && pnpm --dir apps/api dev",
    "lint": "pnpm --dir apps/api lint && pnpm --dir apps/api exec tsc -p ../../tsconfig.json",
    "preflight": "node scripts/deploy-preflight.mjs",
    "test": "node --test scripts/tests/*.test.mjs && pnpm --dir apps/api test",
    "worker": "pnpm --dir apps/api worker"
  },
  "dependencies": {
    "@knowtree/api": "workspace:*",
    "express": "4.22.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "dompurify": "3.4.17",
    "marked": "18.1.2",
    "typescript": "5.9.3"
  }
}
