SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# Any OpenAI-compatible provider. Leave OPENAI_API_KEY empty to run
# classification/embedding in deterministic fallback mode.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
OPENAI_EMBEDDING_MODEL=

CRON_SECRET=replace-with-a-long-random-value

# Optional. On Vercel the page and API are same-origin; leave empty.
ALLOWED_ORIGIN=
